# Public address (Caddy gets a Let's Encrypt certificate for it automatically).
# Without your own domain use <ip-with-dashes>.sslip.io, e.g. 203-0-113-7.sslip.io
DOMAIN=

# --- model (change and run: docker compose up -d) ---
LLM_MODEL=qwen2.5:0.5b
LLM_NUM_CTX=2048          # context window, tokens
LLM_NUM_PREDICT=220       # max length of one AI reaction, tokens
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_REPEAT_PENALTY=1.15
LLM_NUM_THREAD=0          # 0 = auto (1 vCPU -> 1 thread)
LLM_TIMEOUT_S=300         # give up on a generation after this many seconds
CTX_RECENT_MESSAGES=10    # messages sent verbatim; older ones are summarised
SUMMARY_BATCH=8
REPLY_DEBOUNCE_MS=1200    # wait for a near-simultaneous turn of the second player

# memory cap for the Ollama container (2 GB VPS)
OLLAMA_MEM_LIMIT=1400m

# --- rate limits ---
RL_REGISTER_PER_HOUR=10
RL_SEARCH_PER_MIN=20
RL_SEARCH_PER_DAY=300
RL_FRIEND_REQ_PER_HOUR=20
RL_MESSAGES_PER_MIN=30

# --- cloud AI via OpenRouter (optional). Set the key with:  bash set-openrouter-key.sh
# The key stays on this server only; the app never sees it.
OPENROUTER_API_KEY=
CLOUD_TEXT_MODEL=deepseek/deepseek-v4.1-flash
CLOUD_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
CLOUD_MAX_TOKENS=700        # max length of one cloud reaction, tokens
CLOUD_CTX_TOKENS=16000      # how much story the cloud model sees
CLOUD_TEMPERATURE=0.9
CLOUD_REASONING=off         # off | low | medium | high
DEFAULT_AI_MODE=auto        # mode of new scenes: auto (cloud if a key is set) | local | cloud
RL_IMAGES_PER_DAY=30        # scene photos per player per day (they cost money)

# --- персонажи и аватары ---
RL_AVATARS_PER_DAY=20          # AI-аватаров на игрока в сутки
RL_PERSONA_FILL_PER_HOUR=30    # «Придумать с ИИ» в час
MAX_PERSONAS_PER_USER=100
# --- поиск людей и код переноса ---
SEARCH_MIN_CHARS=2
TRANSFER_CODE_TTL_S=600
ONLINE_WINDOW_S=180

# --- облако и админка ---
LOCAL_AI=off                   # маленькая локальная модель выключена: все сцены ведёт облачная
CHAT_PHOTO_TTL_DAYS=7          # свои фото игроков в чате хранятся N дней
RL_CHAT_PHOTOS_PER_HOUR=20
# ADMIN_PASSWORD_HASH=…        # ставится скриптом deploy/set-admin-password.sh
